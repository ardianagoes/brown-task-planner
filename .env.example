NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical public origin; HTTPS is required for production deployments.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional exact hostnames for school-hosted / third-party HTTPS feeds.
# Built in: instructure.com and its subdomains, gradescope.com and its subdomains.
ICS_ALLOWED_HOSTS=canvas.brown.edu
# Floating ICS timestamps (without Z or TZID) use this server timezone.
APP_TIMEZONE=America/New_York
# Server-only OpenAI credentials. Never use NEXT_PUBLIC_ for these.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-5.4-mini
