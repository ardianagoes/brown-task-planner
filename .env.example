NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Canonical public origin; HTTPS is required for production deployments.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Server-only random signing secret (at least 32 characters; recommend 64 hex).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the same value across production instances/deployments. Never NEXT_PUBLIC_.
AUTH_RECOVERY_SECRET=
# Optional exact hostnames for school-hosted / third-party HTTPS feeds.
# Built in: instructure.com and its subdomains, gradescope.com and its subdomains.
ICS_ALLOWED_HOSTS=canvas.brown.edu
# Floating ICS times, Canvas date cutoff and screenshot relative dates use this timezone.
APP_TIMEZONE=America/New_York
# Server-only credentials; never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-5.4-mini
